{
  "name": "cake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "build": "node scripts/validation-run.mjs build",
    "build:slim": "node scripts/validation-run.mjs build:slim",
    "dist:mac": "node scripts/validation-run.mjs dist:mac",
    "package:mac": "node scripts/validation-run.mjs package:mac",
    "test:packaged": "node scripts/validation-run.mjs test:packaged",
    "build:dictation": "node scripts/validation-run.mjs build:dictation",
    "build:speech": "node scripts/validation-run.mjs build:speech",
