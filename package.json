    "electron-vite": "6.0.0",
    "jsdom": "^26.1.0",
    "knip": "^6.32.3",
    "oxfmt": "0.64.0",
    "oxlint": "1.78.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "ws": "8.22.2"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "overrides": {
      "streamdown>mermaid": "-"
    },
    "onlyBuiltDependencies": [
      "@google/genai",
      "electron",
      "esbuild",
      "node-pty",
      "protobufjs"
    ],
    "minimumReleaseAgeExclude": [
      "@earendil-works/chord@1.4.0",
      "@earendil-works/pi-agent-core@1.4.0",
      "@earendil-works/pi-ai@1.4.0",
      "@earendil-works/pi-codemode@1.4.0",
