    "build:browser": "node scripts/validation-run.mjs build:browser",
    "start:server": "node out/server/main.mjs",
    "dev": "node scripts/electron-run-queue.mjs --no-timeout electron-vite dev --watch",
    "dev:agent": "node scripts/electron-run-queue.mjs --no-timeout electron-vite dev --watch --remoteDebuggingPort 9222",
    "dev:manual": "CAKE_MANUAL_RELOAD=1 node scripts/electron-run-queue.mjs --no-timeout electron-vite dev --watch",
