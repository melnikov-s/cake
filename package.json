  "devDependencies": {
    "@effect/tsgo": "0.67.1",
    "@effect/vitest": "4.1.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@oxlint/plugins": "1.78.0",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^21.1.7",
    "@types/mdast": "4.0.4",
