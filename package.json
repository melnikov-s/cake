    "electron:queue": "node scripts/electron-queue-control.mjs",
    "validation:queue": "node scripts/validation-queue-control.mjs",
    "validation:run": "node scripts/validation-run.mjs --",
    "test:validation": "node scripts/validation-run.mjs test:validation",
    "test:electron:run": "node scripts/validation-run.mjs test:electron:run",
    "build:start": "pnpm build && pnpm start",
    "build:start:slim": "pnpm build:slim && pnpm start",
    "test": "node scripts/validation-run.mjs test",
    "test:integration": "node scripts/validation-run.mjs test:integration",
    "test:dictation:native": "node scripts/validation-run.mjs test:dictation:native",
    "test:electron": "node scripts/validation-run.mjs test:electron",
    "test:electron:full": "node scripts/validation-run.mjs test:electron:full",
    "perf:collect": "node scripts/validation-run.mjs perf:collect",
    "perf:check": "node scripts/validation-run.mjs perf:check",
    "perf:accept": "node scripts/performance/user-performance.ts accept",
    "measure:session-switch": "node scripts/validation-run.mjs measure:session-switch",
    "measure:session-references": "node scripts/validation-run.mjs measure:session-references",
    "measure:session-list": "node scripts/validation-run.mjs measure:session-list",
    "measure:backend-amplification": "node scripts/validation-run.mjs measure:backend-amplification",
    "typecheck": "node scripts/validation-run.mjs typecheck",
    "visual:capture": "node scripts/validation-run.mjs visual:capture"
  },
