    "lint:anti-slop:audit": "node scripts/validation-run.mjs lint:anti-slop:audit",
    "postinstall": "effect-tsgo patch --typescript && node scripts/prepare-node-pty.mjs && install-electron",
    "theme:build": "node scripts/validation-run.mjs theme:build",
    "start": "node scripts/start-snapshot.mjs",
    "start:direct": "node scripts/electron-run-queue.mjs --no-timeout electron-vite preview",
