  "tokenColors": [
    {
      "scope": ["comment"],
      "settings": {
        "foreground": "#8c939b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string"],
      "settings": {
        "foreground": "#64c897"
      }
    },
    {
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#f4a25c"
      }
    },
    {
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#f4a25c"
      }
    },
    {
      "scope": ["constant.language"],
      "settings": {
        "foreground": "#59aaf8"
      }
    },
    {
      "scope": ["keyword"],
      "settings": {
        "foreground": "#59aaf8"
      }
    },
    {
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#b4bac0"
      }
    },
    {
      "scope": ["storage"],
      "settings": {
        "foreground": "#59aaf8"
      }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#be9df7"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.enum",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#5fc9db"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#59aaf8"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#be9df7"
      }
    },
    {
      "scope": ["variable"],
      "settings": {
        "foreground": "#dde2e6"
      }
    },
    {
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#c4cacf"
      }
    },
    {
      "scope": ["variable.other.property", "support.variable.property"],
      "settings": {
        "foreground": "#dde2e6"
      }
    },
    {
      "scope": ["meta.object-literal.key"],
      "settings": {
        "foreground": "#c4cacf"
      }
    },
    {
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#be9df7"
      }
    },
    {
      "scope": ["punctuation"],
      "settings": {
        "foreground": "#bcc2c8"
      }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#59aaf8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inline.raw"],
      "settings": {
        "foreground": "#be9df7"
      }
    },
    {
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#64c897"
      }
    },
    {
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#f3625d"
      }
    },
    {
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#f0ba59"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": "#8c939b",
    "string": "#64c897",
