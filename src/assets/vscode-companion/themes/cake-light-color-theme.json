  "tokenColors": [
    {
      "scope": ["comment"],
      "settings": {
        "foreground": "#5c646d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string"],
      "settings": {
        "foreground": "#118659"
      }
    },
    {
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#be6517"
      }
    },
    {
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#be6517"
      }
    },
    {
      "scope": ["constant.language"],
      "settings": {
        "foreground": "#0074ca"
      }
    },
    {
      "scope": ["keyword"],
      "settings": {
        "foreground": "#0074ca"
      }
    },
    {
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#373e45"
      }
    },
    {
      "scope": ["storage"],
      "settings": {
        "foreground": "#0074ca"
      }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#8059bb"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.enum",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#008295"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#0074ca"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#8059bb"
      }
    },
    {
      "scope": ["variable"],
      "settings": {
        "foreground": "#171b20"
      }
    },
    {
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#2a2f36"
      }
    },
    {
      "scope": ["variable.other.property", "support.variable.property"],
      "settings": {
        "foreground": "#171b20"
      }
    },
    {
      "scope": ["meta.object-literal.key"],
      "settings": {
        "foreground": "#2a2f36"
      }
    },
    {
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#8059bb"
      }
    },
    {
      "scope": ["punctuation"],
      "settings": {
        "foreground": "#31373d"
      }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#0074ca",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["markup.inline.raw"],
      "settings": {
        "foreground": "#8059bb"
      }
    },
    {
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#118659"
      }
    },
    {
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#c92f33"
      }
    },
    {
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#cb9317"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": "#5c646d",
    "string": "#118659",
    "number": "#be6517",
    "keyword": "#0074ca",
    "operator": "#373e45",
    "function": "#8059bb",
    "method": "#8059bb",
    "macro": "#8059bb",
    "decorator": "#8059bb",
    "namespace": "#8059bb",
    "class": "#008295",
    "interface": "#008295",
    "enum": "#008295",
    "type": "#008295",
    "typeParameter": "#008295",
    "struct": "#008295",
    "variable": "#171b20",
    "parameter": "#2a2f36",
    "property": "#171b20",
    "enumMember": "#be6517",
    "variable.readonly": "#be6517",
    "event": "#cb9317"
  }
}
