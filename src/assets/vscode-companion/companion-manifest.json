{
  "name": "cake-companion",
  "displayName": "Cake Companion",
  "version": "1.0.0",
  "private": true,
  "description": "Bridges the embedded VS Code editor with Cake: reveal requests in, editor activity out.",
  "license": "UNLICENSED",
