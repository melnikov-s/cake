{
  "name": "cake-companion",
  "displayName": "Cake Companion",
  "version": "1.0.0",
  "private": true,
  "description": "Bridges embedded VS Code with Cake source reveals, editor context, and discussions.",
  "license": "UNLICENSED",
  "publisher": "cake",
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cake.reveal",
        "title": "Cake: Reveal File"
      },
      {
        "command": "cake.backToAgent",
        "title": "Cake: Back to Agent",
        "icon": "$(arrow-left)"
      },
      {
        "command": "cake.toggleChatSidebar",
        "title": "Cake: Toggle Chat Sidebar",
        "icon": "$(layout-sidebar-right)"
      }
    ]
  },
  "activationEvents": ["onStartupFinished"],
  "engines": {
    "vscode": "^1.80.0"
  }
}
