  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cake.reveal",
        "title": "Cake: Reveal File"
      }
    ]
  },
  "activationEvents": ["onStartupFinished"],
  "engines": {
    "vscode": "^1.80.0"
  }
}
